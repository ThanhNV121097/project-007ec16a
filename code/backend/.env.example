# Backend environment. Copy to .env for `go run ./cmd/api`; never commit real values.
# In docker compose and in a deployment the runtime injects PORT and DATABASE_URL itself.

# Port to listen on. Falls back to APP_PORT, then 8080.
PORT=8080

# Postgres connection string. The backend reads this whole DSN and never assembles one from parts.
# Pool options ride in it, e.g. ?sslmode=disable&pool_max_conns=10
DATABASE_URL=postgres://app:app_secret@localhost:5432/app?sslmode=disable

# Browser origins allowed to call the API with cookies, comma-separated. Leave empty in deployment:
# the browser reaches the API on its own origin under /api. Set it only when the frontend runs on
# another origin, e.g. `npm run dev` with VITE_API_URL pointed at this server.
CORS_ALLOWED_ORIGINS=

# --- Read by later stories (not by the scaffold yet). Supplied by the owner in the console; leave empty here. ---

# Dealer sign-in story: the admin account is made from these at start-up. Password: 10 to 100 characters.
# Leave either empty and the server still starts, with nobody able to sign in as admin. Changing the password
# (or the email) here and restarting changes the account and ends every session the admin holds.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Online payment story: VNPay terminal code and hash secret (sandbox first). Never expose either to the browser.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
