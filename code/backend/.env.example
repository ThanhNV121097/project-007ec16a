# Backend environment. Copy to .env for `go run ./cmd/api`; never commit real values.
# In docker compose and in a deployment the runtime injects PORT and DATABASE_URL itself.

# Port to listen on. Falls back to APP_PORT, then 8080.
PORT=8080

# Postgres connection string. The backend reads this whole DSN and never assembles one from parts.
# Pool options ride in it, e.g. ?sslmode=disable&pool_max_conns=10
DATABASE_URL=postgres://app:app_secret@localhost:5432/app?sslmode=disable

# Browser origins allowed to call the API with cookies, comma-separated. Leave empty in deployment:
# the browser reaches the API on its own origin under /api. Set it only when the frontend runs on
# another origin, e.g. `npm run dev` with VITE_API_URL pointed at this server.
CORS_ALLOWED_ORIGINS=

# --- Read by later stories (not by the scaffold yet). Supplied by the owner in the console; leave empty here. ---

# Dealer sign-in story: the admin account is made from these at start-up. Password: 10 to 100 characters.
# Leave either empty and the server still starts, with nobody able to sign in as admin. Changing the password
# (or the email) here and restarting changes the account and ends every session the admin holds.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Online payment story: VNPay terminal code and hash secret (sandbox first). Never expose either to the browser.
# With either empty the server still starts: checkout shows online payment as unavailable and placing an order answers 503.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# VNPay's payment page. Empty means VNPay's sandbox page; going live changes this value, not the code.
VNPAY_PAYMENT_URL=

# The shop's public origin (scheme and host, no path) VNPay sends the customer back to, e.g. https://shop.example.com.
# Leave empty when the edge proxy forwards X-Forwarded-Proto and X-Forwarded-Host.
PUBLIC_BASE_URL=

# The owner registers <public origin>/api/v1/payments/vnpay/ipn in VNPay's merchant portal for the terminal.

# More ways to pay story. Each way is offered at checkout only while ALL its settings are set and valid; a missing or
# malformed one never stops the server (the key's name is logged once, never its value).

# MoMo wallet: the merchant's partner code, access key and secret key from MoMo's portal (sandbox first). The two keys
# are secrets: never expose them to the browser.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# MoMo's base address. Empty means MoMo's sandbox (https://test-payment.momo.vn); going live changes this value, not the code.
MOMO_API_URL=
# The owner registers <public origin>/api/v1/payments/momo/ipn in MoMo's merchant portal.

# Bank transfer (VietQR): the shop's own account. BIN is the bank's six-digit NAPAS code (for example 970436); the
# account number is 1 to 19 letters or digits. Served only by an order's own transfer-details call.
VIETQR_BANK_BIN=
VIETQR_BANK_NAME=
VIETQR_ACCOUNT_NUMBER=
VIETQR_ACCOUNT_NAME=
