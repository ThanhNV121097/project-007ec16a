# Frontend environment. Vite reads VITE_* at BUILD time and bakes it into the bundle, so never put a secret here.

# Base address of the API. Leave it UNSET: the browser then calls /api on its own origin, which the edge
# proxy (deploy.yml) strips and forwards to the backend, so the session cookie stays same-origin.
# Set it only to run `npm run dev` against a backend on another port, and then list this site's origin in
# the backend's CORS_ALLOWED_ORIGINS. An empty value is NOT the same as unset: it would break every URL.
# VITE_API_URL=http://localhost:8080
