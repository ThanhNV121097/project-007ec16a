# Shared keys for docker-compose.yml. Copy to .env; never commit real values.

# The project's own Postgres lives in the compose profile `local`, which a deployment leaves off (it uses the
# shared server). Naming the profile here makes a plain `docker compose up` start it, as CI's
# `docker compose --profile local up -d --wait` does. Without it the backend has no database to wait for.
COMPOSE_PROFILES=local

# The backend's DATABASE_URL is built from these three by docker-compose.yml.
POSTGRES_USER=app
POSTGRES_PASSWORD=app_secret
POSTGRES_DB=app

# Host ports for the backend and the frontend.
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Optional memory ceilings per container; raise one if its container is OOM-killed.
# POSTGRES_MEM_LIMIT=512m
# BACKEND_MEM_LIMIT=768m
# FRONTEND_MEM_LIMIT=768m

# The owner's secrets (ADMIN_EMAIL, ADMIN_PASSWORD, VNPAY_TMN_CODE, VNPAY_HASH_SECRET) are NOT compose keys:
# a deployment hands them to the backend through .env.deploy, and the console supplies them to a local run.
# See code/backend/.env.example for the full list the backend reads.
